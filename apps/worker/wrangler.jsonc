{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "lingua-tutor-api",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-07-12",
  "build": {
    "command": "cargo install -q worker-build && worker-build --release"
  },
  // PWA served by the same Worker: one origin, no CORS (09-frontend.md §1).
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AUTH_ENFORCED": "false", // local dev; production overrides below
    "TOKEN_SIGNING_KEY": "local-dev-only-key" // prod: wrangler secret put
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lingua-tutor-dev",
      // Real dev DB (Terraform); wrangler dev --local ignores the id.
      "database_id": "30f6ac95-78e9-4993-9d38-b8173d76bb46",
      "migrations_dir": "../../migrations"
    }
  ],
  "env": {
    "production": {
      "name": "lingua-tutor-api",
      "vars": {
        "AUTH_ENFORCED": "true",
        "ACCESS_TEAM_DOMAIN": "absent-twin.cloudflareaccess.com",
        "ACCESS_AUD": "ef3a0e549f57c25821692fe4adcf596ca53da43e6f95cbbec54099aaf4f11657",
        "OWNER_EMAIL": "aleksey.gredyaev.dev@gmail.com"
      },
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lingua-tutor-prod",
          "database_id": "0ea14e2b-4462-48d7-99ac-aea7f8c797c1",
          "migrations_dir": "../../migrations"
        }
      ]
    }
  }
}
